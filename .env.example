# Copy to .env.local and fill in. The publishable key is safe to expose in the
# frontend bundle; security is enforced by Row-Level Security in Supabase.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Both people must share the same trip id to see the same trip.
VITE_TRIP_ID=shared-trip
